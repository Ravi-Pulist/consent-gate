{
  "$comment": "Generated by rmad init from domain-packs/healthcare/manifest.yaml. Edit the manifest and re-run init, or edit this file directly for project-specific detectors.",
  "domain": "healthcare",
  "classification": "phi",
  "exfiltration": {
    "enabled": true
  },
  "patterns": [
    {
      "name": "ssn",
      "description": "Social Security Number",
      "regex": "\\\\b\\\\d{3}-\\\\d{2}-\\\\d{4}\\\\b",
      "severity": "critical",
      "action": "block"
    },
    {
      "name": "mrn",
      "description": "Medical Record Number",
      "fieldNames": [
        "mrn",
        "medical_record",
        "patient_id",
        "patientId"
      ],
      "severity": "high",
      "action": "warn"
    },
    {
      "name": "dob",
      "description": "Date of Birth in patient context",
      "fieldNames": [
        "date_of_birth",
        "dob",
        "birthDate",
        "birth_date"
      ],
      "severity": "high",
      "action": "warn"
    },
    {
      "name": "diagnosis-code",
      "description": "ICD-10 diagnosis codes in patient context",
      "regex": "\\\\b[A-Z]\\\\d{2}\\\\.\\\\d{1,4}\\\\b",
      "severity": "medium",
      "action": "log"
    }
  ]
}
