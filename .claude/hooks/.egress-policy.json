{
  "$comment": "RMAD egress policy. mode: off | warn | enforce. Ships as warn: it reports what it would deny without denying it, so you can read the ledger before turning the key. deny beats allow. An entry \"github.com\" matches the apex and its subdomains; \"*.github.com\" matches subdomains only.",
  "mode": "warn",
  "allowLocal": true,
  "allowWebSearch": true,
  "allowConfiguredEndpoints": true,
  "allow": [
    "registry.npmjs.org",
    "*.npmjs.org",
    "registry.yarnpkg.com",
    "nodejs.org",
    "*.nodejs.org",
    "pypi.org",
    "*.pypi.org",
    "files.pythonhosted.org",
    "crates.io",
    "static.crates.io",
    "proxy.golang.org",
    "sum.golang.org",
    "repo.maven.apache.org",
    "rubygems.org",
    "*.rubygems.org",
    "github.com",
    "*.github.com",
    "raw.githubusercontent.com",
    "objects.githubusercontent.com",
    "codeload.github.com",
    "gitlab.com",
    "*.gitlab.com",
    "bitbucket.org",
    "api.anthropic.com",
    "anthropic.com",
    "*.anthropic.com"
  ],
  "deny": []
}
